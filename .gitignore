# ==========================================
# Large Datasets & Processed Data
# ==========================================
# Prevent committing large datasets (>100MB exceeds GitHub limits)
data/training/train.csv
data/training/train_features.csv
data/training/test_features.csv
data/training/val_features.csv

# Uploaded / generated test files
dummy_resume.pdf
data/resumes/*.pdf
!data/resumes/sample_ml_resume.pdf

# Preserve directory structures
!**/data/**/.gitkeep
!**/models/**/.gitkeep

# ==========================================
# Machine Learning Models & Checkpoints
# ==========================================
# Model binary weights and pickle files
*.pkl
*.joblib
*.pt
*.pth
*.bin
*.onnx
*.h5

# Keep metadata & evaluation metrics
!models/evaluation_results.json
!models/model_meta.json

